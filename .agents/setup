#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
mkdir -p "$HOME/.cache/amp/logs"
exec > >(tee -a "$HOME/.cache/amp/logs/setup.log") 2>&1

BUN_VERSION=1.3.10

run_step() {
  local description="$1"
  shift
  local started=$SECONDS
  printf '\n==> %s\n' "$description"
  "$@"
  printf '<== %s (%ss)\n' "$description" "$((SECONDS - started))"
}

ensure_bun() {
  if command -v bun >/dev/null && [[ "$(bun --version)" == "$BUN_VERSION" ]]; then
    return
  fi

  curl -fsSL https://bun.sh/install | bash -s "bun-v$BUN_VERSION"
  export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
  export PATH="$BUN_INSTALL/bin:$PATH"
  [[ "$(bun --version)" == "$BUN_VERSION" ]]
}

run_step "Ensure Bun $BUN_VERSION" ensure_bun
run_step "Install locked dependencies" bun install --frozen-lockfile

if [[ ! -f .env.local && -f .env.example ]]; then
  cp -- .env.example .env.local
fi
